{
  "name": "@devdengchao/yunxin-console-mcp",
  "version": "0.1.1",
  "description": "Unofficial MCP server for the NetEase Yunxin admin console (app management, IM configuration, statistics)",
  "type": "module",
  "bin": {
    "yunxin-console-mcp": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "docs",
    "LICENSE",
    "SECURITY.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevDengChao/yunxin-console-mcp.git"
  },
  "homepage": "https://github.com/DevDengChao/yunxin-console-mcp#readme",
  "bugs": {
    "url": "https://github.com/DevDengChao/yunxin-console-mcp/issues"
  },
  "author": "DevDengChao <2325690622@qq.com>",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "login": "tsx src/cli.ts login",
    "auth": "tsx src/cli.ts auth",
    "pretest": "npm run build",
    "test": "vitest run",
    "presmoke": "npm run build",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm run typecheck && vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "yunxin",
    "netease",
    "im",
    "rtc",
    "console",
    "admin"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright-core": "^1.64.1",
    "tough-cookie": "^6.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
